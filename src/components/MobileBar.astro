---
import { url } from '../lib/url';
import { site } from '../config/site';
import Icon from './Icon.astro';
---
<nav class="mobile-bar" aria-label="Quick contact">
  <a href={site.phoneHref}><Icon name="phone" size={20} /><span>Call</span></a>
  <a href={site.whatsappHref} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /><span>WhatsApp</span></a>
  <a href={url('/#quote')} class="mobile-bar__primary"><Icon name="mail" size={20} /><span>Get Quote</span></a>
</nav>
