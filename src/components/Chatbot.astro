---
import { site } from '../config/site';
import { chatTopics, chatText } from '../data/chatbot';
import Icon from './Icon.astro';

const key = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const data = { topics: chatTopics, text: chatText };
---
<div class="chat" data-chat data-key={key} data-email={site.email}>
  <button class="chat__launcher" type="button" aria-label={chatText.launcher} aria-expanded="false" aria-controls="chat-panel" data-chat-toggle>
    <span class="chat__launcher-icon chat__launcher-icon--open" aria-hidden="true">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.6A8 8 0 1 1 21 12Z"/><path d="M8.5 11h.01M12 11h.01M15.5 11h.01"/></svg>
    </span>
    <span class="chat__launcher-icon chat__launcher-icon--close" aria-hidden="true"><Icon name="close" size={26} /></span>
    <span class="chat__launcher-label">{chatText.launcher}</span>
  </button>

  <section class="chat__panel" id="chat-panel" role="dialog" aria-modal="false" aria-labelledby="chat-title" hidden>
    <header class="chat__head">
      <span class="chat__avatar" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 36 36"><path d="M11 11h14l-14 14h14" fill="none" stroke="#fff" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
      <div class="chat__head-text">
        <h2 id="chat-title">{chatText.title}</h2>
        <p>{chatText.subtitle}</p>
      </div>
      <button class="chat__close" type="button" aria-label="Close chat" data-chat-close><Icon name="close" size={22} /></button>
    </header>
    <div class="chat__log" role="log" aria-live="polite" data-chat-log></div>
    <div class="chat__chips" data-chat-chips></div>
    <form class="chat__input" data-chat-form autocomplete="off">
      <label class="sr-only" for="chat-input">Message</label>
      <input id="chat-input" type="text" maxlength="200" placeholder={chatText.placeholder} data-chat-input />
      <button type="submit" aria-label="Send"><Icon name="arrow" size={20} /></button>
    </form>
  </section>
  <script type="application/json" id="chat-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
</div>
